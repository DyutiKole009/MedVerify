# ==========================================
# MedVerify Backend Environment Configuration
# ==========================================

# AWS Core Configuration
AWS_REGION=us-east-1
# AWS credentials are only required for local development outside AWS Lambda/SSO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DynamoDB Tables (On-demand capacity)
DYNAMODB_BATCHES_TABLE=MedVerify_Batches
DYNAMODB_REPORTS_TABLE=MedVerify_Reports
DYNAMODB_SESSIONS_TABLE=MedVerify_Sessions
DYNAMODB_MANUFACTURERS_TABLE=MedVerify_Manufacturers
DYNAMODB_INGESTED_DOCS_TABLE=MedVerify_IngestedDocs

# S3 Buckets
S3_RAW_DOCUMENTS_BUCKET=medverify-raw-documents
S3_UPLOADS_BUCKET=medverify-uploads
S3_KB_DOCUMENTS_BUCKET=medverify-kb-documents

# Bedrock Foundation Models (Use cross-region inference profile IDs where required)
BEDROCK_ORCHESTRATOR_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_SYNTHESIS_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_DEEP_AGENT_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock Knowledge Base & AgentCore Memory
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_NOTICES_ID=
BEDROCK_KB_DATA_SOURCE_CASES_ID=
AGENTCORE_MEMORY_ID=medverify-investigation-memory

# AWS Step Functions (Reactive Agent Workflow)
STATE_MACHINE_REACTIVE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:MedVerifyReactiveVerification

# Amazon EventBridge & SNS
EVENT_BUS_NAME=default
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:medverify-spurious-alerts

# Amazon Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# OpenSearch Serverless (Fuzzy Matching & Vector Search)
OPENSEARCH_ENDPOINT=https://example-collection.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX_DRUGS=medverify-drugs

# Server & Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
